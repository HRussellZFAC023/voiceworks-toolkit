{
  "name": "asmr-one-ultimate",
  "description": "Upgrade asmr.one with an all-in-one power suite: on-device Whisper transcription, local neural JA/CN→EN translation, AI semantic search, radio mode, learner mode with dual-language subtitles, JPDB vocabulary mining, media viewer, audio visualizer, auto-progress tracking, keyboard shortcuts, playlist mode, offline caching, and more. Everything runs locally in your browser with WebGPU acceleration.",
  "private": false,
  "version": "143",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage",
    "version:bump": "node -e \"const p=require('./package.json');const fs=require('fs');p.version=String(Number(p.version)+1);fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n');console.log(p.version)\"",
    "release": "node scripts/release.mjs"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,vue}": [
      "npm run test:run --"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "fuse.js": "^7.1.0",
    "idb": "^8.0.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.1.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.2.7",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-monkey": "^3.5.1",
    "vitest": "^1.3.1",
    "vue-tsc": "^2.2.0"
  }
}
