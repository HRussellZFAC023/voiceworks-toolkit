{
  "name": "asmr-one-ultimate",
  "description": "Upgrade asmr.one with on-device Whisper, cached/custom translation, semantic search, radio and learner modes, playlist backups, JPDB vocabulary mining, media tools, and automatic language-gate recovery.",
  "private": false,
  "version": "154",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-size.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage",
    "version:bump": "node -e \"const p=require('./package.json');const fs=require('fs');p.version=String(Number(p.version)+1);fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n');console.log(p.version)\"",
    "release": "node scripts/release.mjs"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,vue}": [
      "npm run test:run --"
    ]
  },
  "dependencies": {
    "fuse.js": "^7.1.0",
    "idb": "^8.0.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.1.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.6",
    "@vue/test-utils": "^2.4.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.2.7",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vite-plugin-monkey": "^3.5.2",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.2.0"
  }
}
