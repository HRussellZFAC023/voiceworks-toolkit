{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "asmr-api-proxy",
    "main": "asmr-api-proxy.js",
    "compatibility_date": "2026-07-16",
    // Run in Japan so the asmr API's region gate sees an allowed country.
    "placement": { "mode": "targeted", "region": "azure:japaneast" },
    "r2_buckets": [
        {
            "binding": "SEMANTIC_INDEX",
            "bucket_name": "asmr-semantic-index"
        }
    ],
    // Anonymous playlist submissions are intentionally narrow and idempotent.
    // This limiter is abuse friction; R2's create-only UUID key is definitive.
    "ratelimits": [
        {
            "name": "COMMUNITY_SUBMISSION_RATE_LIMITER",
            "namespace_id": "563283162",
            "simple": { "limit": 20, "period": 60 }
        }
    ],
    "observability": { "enabled": true }
}
